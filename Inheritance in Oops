//Multilevel Inheritance
#include<iostream>
using namespace std;

class Vehicle
{
    protected:
    string name;
};

class Car : public Vehicle
{
    protected:
    int model;
};

class Electric : public Car
{
  int year;
  public:
  Electric(string n, int m, int y )
  {
    name = n;
    model = m;
    year = y;
  }
  void display()
  {
    cout<<name<<" "<<model<<" "<<year;
  }
};

int main()
{
    Electric obj("Mahindra" ,20, 2026 );
    obj.display();
}
