//Single Inheritance
#include<iostream>
using namespace std;

class Vehicle
{
    protected:
    string name;
};
class Car : public Vehicle
{
    int model;
    public:
    Car(string n, int m)
    {
        name = n;
        model = m;
    }
    void display()
    {
        cout<<name<<" "<<model<<endl;
    }
};
int main()
{
    Car obj("Mahindra" ,20);
    obj.display();
}
